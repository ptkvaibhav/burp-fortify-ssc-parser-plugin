<?xml version="1.0" encoding="utf-8" ?>
<plugin xmlns="xmlns://www.fortify.com/schema/pluginmanifest-1.0.xsd"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="PluginDescriptor"
        id="com.fortify.plugin.burp.BurpParserPlugin" api-version="1.0">
    <plugin-info>
        <name>Burp Suite Parser Plugin</name>
        <version>2.1.0</version>
        <data-version>2</data-version>
        <vendor name="Pratik Vaibhav" url="https://github.com/ptkvaibhav/burp-fortify-ssc-parser-plugin"/>
        <description>Imports PortSwigger Burp Suite XML scan results (Report selected issues as XML). Community plugin, not affiliated with OpenText or PortSwigger.</description>
        <resources>
            <localization>
                <language id="default" location="/resources/messages_en.properties"/>
                <language id="en" location="/resources/messages_en.properties"/>
            </localization>
            <images>
                <image imageType="icon" location="/images/icon.png"/>
                <image imageType="logo" location="/images/logo.png"/>
            </images>
        </resources>
    </plugin-info>
    <issue-parser xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <engine-type>BURP</engine-type>
        <view-template location="/viewtemplate/ViewTemplate.json">
            <description>Default vulnerability view template for Burp Suite.</description>
        </view-template>
    </issue-parser>
</plugin>
